{
  "permissions": {
    "execute": {
      "allow": [
        "Read",
        "Write",
        "Edit",
        "Bash"
      ]
    }
  },
  "execution": {
    "mode": "sequential",
    "max_parallel": 1
  },
  "subagents": {
    "execute": {
      "provider": "claude",
      "localLlm": {
        "enabled": true
      }
    }
  },
  "approval": {
    "autoApprove": false
  }
}
