# Local LLM configuration for harness Phase 4a
# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real values.

# ── Local development (CPU) ───────────────────────────────────────────────────
# Uses docker-compose.yml (CPU-only, qwen3.5:4b)
#
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# ── EC2 g5.4xlarge (NVIDIA A10G GPU) ─────────────────────────────────────────
# Uses docker-compose.dev.yml (GPU, qwen2.5-coder:32b via harness-coder model)
#
# 1. Copy this file:  cp .env.example .env
# 2. Uncomment below and comment out the CPU section above
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=harness-coder

# ── Optional overrides ────────────────────────────────────────────────────────
# OLLAMA_TIMEOUT_MS=180000   # per-request timeout in ms (default: 180000)
#                            # increase if running large models on CPU
