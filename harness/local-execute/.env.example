# Local LLM configuration for harness Phase 4a
# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real values.

# Ollama endpoint (default: local Docker container)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for implementation (must support tool/function calling)
# Recommended: qwen2.5-coder, qwen3.5:4b, llama3.1, mistral-nemo
OLLAMA_MODEL=qwen3.5:4b

# Optional overrides
# OLLAMA_TIMEOUT_MS=180000   # per-request timeout in ms (default: 180000)
