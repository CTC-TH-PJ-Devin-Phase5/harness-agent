# Copy to harness/litellm/.env and fill in real values (never commit .env).

# Router 1 — AWS Bedrock credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-northeast-1

# Router 2 — OpenRouter (for sub-agents, currently unused — kept for reference)
# OPENROUTER_API_KEY=sk-or-v1-...

# Router 3 — Local Ollama (execute sub-agent via haiku alias)
# EC2: http://<ec2-public-ip>:11434  |  local: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11435
# OpenAI-compat endpoint — must end with /v1 (used by openai/ provider for tool calling)
OLLAMA_BASE_URL_V1=http://host.docker.internal:11435/v1

# Shared secret — must match ANTHROPIC_API_KEY in .claude/settings.local.json
# Can be any string (e.g. sk-harness), since you're on Bedrock not direct Anthropic.
LITELLM_MASTER_KEY=sk-harness
